      "normal",
      "karras"
     ]
    ],
    "positive": [
     "CONDITIONING"
    ],
    "negative": [
     "CONDITIONING"
    ],
    "latent_image": [
     "LATENT"
    ],
    "denoise": [
     "FLOAT",
     {
      "default": 1.0
     }
    ]
   }
  }
 },
