     {
      "default": 1
     }
    ]
   }
  }
 },
 "KSampler": {
  "display_name": "KSampler",
  "input": {
   "required": {
    "model": [
     "MODEL"
    ],
    "seed": [
     "INT",
     {
      "default": 0,
      "control_after_generate": true
     }
    ],
    "steps": [
     "INT",
