{
  "episodes": [
    {
      "id": "demo-e1",
      "ep": 1,
      "title": "红伞",
      "hook": "门口那把红伞，和三年没见的字迹。",
      "cliffhanger": "她拿起了那把伞",
      "seconds": 34,
      "scenes": 2,
      "beats": [
        { "id": "demo-bt1", "text": "雨夜，林晚加完班回老小区，一层层爬上六楼。", "emotion": -0.3, "paras": [1] },
        { "id": "demo-bt2", "text": "门口靠着一把红伞，便利贴上是周屿三年没见的字迹。", "emotion": 0.2, "paras": [2] },
        { "id": "demo-bt3", "text": "便利贴只有一句：楼下便利店，等你到十二点。", "emotion": 0.4, "paras": [3] },
        { "id": "demo-bt4", "text": "她把伞靠回墙边，进屋又出来，来回犹豫。", "emotion": -0.4, "paras": [4] },
        { "id": "demo-bt5", "text": "她还是拿起了那把伞。", "emotion": 0.5, "paras": [5] }
      ]
    },
    {
      "id": "demo-e2",
      "ep": 2,
      "title": "十二点",
      "hook": "她赶到便利店，离十二点还有四分钟。",
      "cliffhanger": "便利店里没有他",
      "seconds": 70,
      "scenes": 2,
      "beats": [
        { "id": "demo-bt6", "text": "她攥着伞冲下楼，跑到三楼才发现鞋都没换。", "emotion": 0.3, "paras": [6, 7] },
        { "id": "demo-bt7", "text": "单元门外撑开红伞，伞柄上那截缠过的铁丝还在。", "emotion": 0.1, "paras": [8, 9, 10, 11, 12] },
        { "id": "demo-bt8", "text": "一路狂奔两百米，泥水溅满小腿，差点撞上外卖员。", "emotion": 0.5, "paras": [13, 14] },
        { "id": "demo-bt9", "text": "岗亭里的老歌，勾起三年前便利店的那个夏天。", "emotion": 0.1, "paras": [15, 16] },
        { "id": "demo-bt10", "text": "推门前看手机：23:56，离十二点还有四分钟。", "emotion": 0.6, "paras": [17, 18, 19, 20, 21] },
        { "id": "demo-bt11", "text": "高脚桌上两杯关东煮，玻璃的水汽上画着伞下两个小人。", "emotion": 0.3, "paras": [22, 23, 24, 25] },
        { "id": "demo-bt12", "text": "没开过的那杯已经凉透，店员说那人盯了门口一晚上。", "emotion": -0.2, "paras": [26, 27, 28] },
        { "id": "demo-bt13", "text": "电子钟跳到 00:00，她把整个店找了一遍。", "emotion": -0.6, "paras": [29, 30] },
        { "id": "demo-bt14", "text": "便利店里没有他。", "emotion": -0.9, "paras": [31] }
      ]
    },
    {
      "id": "demo-e3",
      "ep": 3,
      "title": "旧发圈",
      "hook": "他留下一张三年前的小票：黑色发圈，一个，两块钱。",
      "cliffhanger": "红伞底下，雨还没有停",
      "seconds": 80,
      "scenes": 3,
      "beats": [
        { "id": "demo-bt15", "text": "店员递来他留下的信封，里面是三年前买发圈的小票。", "emotion": -0.3, "paras": [32, 33, 34] },
        { "id": "demo-bt16", "text": "她握住手腕上的旧发圈，想起毕业那晚他没说完的话。", "emotion": -0.5, "paras": [35, 36, 37, 38, 39, 40] },
        { "id": "demo-bt17", "text": "小票背面：欠你的那句话，雨停之前说。", "emotion": 0.2, "paras": [41, 42, 43] },
        { "id": "demo-bt18", "text": "他空着手走进了雨里；马路对面的站台下，站着周屿。", "emotion": 0.4, "paras": [44, 45, 46, 47, 48] },
        { "id": "demo-bt19", "text": "她冲进雨里，末班车开走了，站台下的人还在。", "emotion": 0.6, "paras": [49, 50, 51] },
        { "id": "demo-bt20", "text": "红伞举过他头顶，三年没说的话一句一句说出口。", "emotion": 0.3, "paras": [52, 53, 54, 55, 56, 60, 61, 62, 63] },
        { "id": "demo-bt21", "text": "他看见那根发圈；她背过身，让他再扎一次头发。", "emotion": 0.7, "paras": [57, 58, 59, 64, 65, 66, 67, 68, 69] },
        { "id": "demo-bt22", "text": "红伞底下，雨还没有停。", "emotion": 0.8, "paras": [70, 71] }
      ]
    }
  ]
}
