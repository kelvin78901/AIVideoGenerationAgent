            "chapters": [
              {
                "idx": 0,
                "title": "第一章 红伞",
                "summary": "雨夜，林晚回家时发现门口靠着一把红伞和周屿留下的便利贴：楼下便利店，等你到十二点。她犹豫再三，拿起了伞。"
              },
              {
                "idx": 1,
                "title": "第二章 十二点",
                "summary": "林晚撑着红伞跑去便利店，一路想起和周屿的往事。到店时 23:56，桌上留着两杯关东煮，周屿已经不在。"
              },
              {
                "idx": 2,
                "title": "第三章 旧发圈",
                "summary": "店员转交一张三年前买发圈的旧小票，背面写着“欠你的那句话，雨停之前说”。林晚在公交站台追上周屿，让他再帮自己扎一次头发。"
              }
            ],
