              "source_id": "demo-src",
              "start": 98,
              "end": 124
            }
          ]
        },
        {
          "id": "demo-bt4",
          "episode_id": "demo-e1",
          "idx": 4,
          "text": "她把伞靠回墙边，进屋又出来，来回犹豫。",
          "emotion": -0.4,
          "paras": [
            3
          ],
          "source_spans": [
            {
              "source_id": "demo-src",
              "start": 125,
              "end": 145
