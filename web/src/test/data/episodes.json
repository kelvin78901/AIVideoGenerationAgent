        {
          "id": "demo-bt1",
          "episode_id": "demo-e1",
          "idx": 1,
          "text": "雨夜，林晚加完班回老小区，一层层爬上六楼。",
          "emotion": -0.3,
          "paras": [
            0
          ],
          "source_spans": [
            {
              "source_id": "demo-src",
              "start": 8,
              "end": 36
            }
          ]
        },
        {
          "id": "demo-bt2",
          "episode_id": "demo-e1",
          "idx": 2,
          "text": "门口靠着一把红伞，便利贴上是周屿三年没见的字迹。",
          "emotion": 0.2,
          "paras": [
            1
          ],
          "source_spans": [
            {
              "source_id": "demo-src",
              "start": 37,
              "end": 97
            }
          ]
        },
        {
          "id": "demo-bt3",
          "episode_id": "demo-e1",
          "idx": 3,
          "text": "便利贴只有一句：楼下便利店，等你到十二点。",
          "emotion": 0.4,
          "paras": [
            2
          ],
          "source_spans": [
