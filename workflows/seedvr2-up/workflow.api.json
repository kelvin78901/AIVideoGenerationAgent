{
  "1": {
    "class_type": "LoadVideo",
    "inputs": { "file": "example.mp4" },
    "_meta": { "title": "Video in" }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": { "video": ["1", 0] },
    "_meta": { "title": "Frames and sound" }
  },
  "3": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["2", 0],
      "resize_type": "scale dimensions",
      "resize_type.width": 1080,
      "resize_type.height": 1920,
      "resize_type.crop": "center",
      "scale_method": "lanczos"
    },
    "_meta": { "title": "Size" }
  },
  "4": {
    "class_type": "SeedVR2Preprocess",
    "inputs": { "resized_images": ["3", 0] },
    "_meta": { "title": "Preprocess" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "seedvr2_ema_vae_fp16.safetensors" },
    "_meta": { "title": "SeedVR2 VAE" }
  },
  "6": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "seedvr2_7b_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "SeedVR2 7B" }
  },
  "7": {
    "class_type": "VAEEncodeTiled",
    "inputs": {
      "pixels": ["4", 0],
      "vae": ["5", 0],
      "tile_size": 512,
      "overlap": 128,
      "temporal_size": 64,
      "temporal_overlap": 8
    },
    "_meta": { "title": "Encode" }
  },
  "8": {
    "class_type": "SeedVR2TemporalChunk",
    "inputs": { "latent": ["7", 0], "temporal_overlap": 2, "chunking_mode": "auto" },
    "_meta": { "title": "Chunks" }
  },
  "9": {
    "class_type": "SeedVR2Conditioning",
    "inputs": { "model": ["6", 0], "vae_conditioning": ["8", 0] },
    "_meta": { "title": "Conditioning" }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["6", 0],
      "seed": 959948902156062,
      "steps": 1,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["8", 0],
      "denoise": 1.0
    },
    "_meta": { "title": "Restore" }
  },
  "11": {
    "class_type": "SeedVR2TemporalMerge",
    "inputs": { "latents": ["10", 0], "temporal_overlap": ["8", 1] },
    "_meta": { "title": "Merge" }
  },
  "12": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["11", 0],
      "vae": ["5", 0],
      "tile_size": 512,
      "overlap": 128,
      "temporal_size": 64,
      "temporal_overlap": 8
    },
    "_meta": { "title": "Decode" }
  },
  "13": {
    "class_type": "SeedVR2PostProcessing",
    "inputs": {
      "images": ["12", 0],
      "original_resized_images": ["3", 0],
      "color_correction_method": "lab"
    },
    "_meta": { "title": "Colour fix" }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["13", 0], "audio": ["2", 1], "fps": ["2", 2] },
    "_meta": { "title": "Video" }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["14", 0],
      "filename_prefix": "dramastudio/seedvr2",
      "format": "auto",
      "format.codec": "auto"
    },
    "_meta": { "title": "Output" }
  }
}
