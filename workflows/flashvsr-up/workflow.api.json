{
  "1": {
    "class_type": "LoadVideo",
    "inputs": { "file": "example.mp4" },
    "_meta": { "title": "Video in" }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": { "video": ["1", 0] },
    "_meta": { "title": "Frames and sound" }
  },
  "3": {
    "class_type": "AILab_FlashVSR",
    "inputs": {
      "frames": ["2", 0],
      "preset": "Balanced (2x Quality)",
      "scale": 2,
      "unload_model": true,
      "seed": 1,
      "audio": ["2", 1]
    },
    "_meta": { "title": "FlashVSR" }
  },
  "4": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["3", 0],
      "resize_type": "scale dimensions",
      "resize_type.width": 1080,
      "resize_type.height": 1920,
      "resize_type.crop": "center",
      "scale_method": "lanczos"
    },
    "_meta": { "title": "Size" }
  },
  "5": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["4", 0], "audio": ["2", 1], "fps": ["2", 2] },
    "_meta": { "title": "Video" }
  },
  "6": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["5", 0],
      "filename_prefix": "dramastudio/flashvsr",
      "format": "auto",
      "format.codec": "auto"
    },
    "_meta": { "title": "Output" }
  }
}
